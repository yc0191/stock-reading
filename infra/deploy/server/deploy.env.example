# 서비스 서버의 배포 설정 예시. 서버에서 /etc/stock-reading/deploy.env 로 복사해 채운다(권한 0640, 비밀값은 여기에 두지 않는다).
# 이 파일은 배포 적용 스크립트가 읽고, Compose 의 --env-file 로도 쓰므로 KEY=값 한 줄씩 쓴다(이 파일에는 비밀값이 없어 따옴표가 필요 없다).
# 비밀값(DB 비밀번호, API 키, SMTP 비밀번호 등)은 Parameter Store 에서 받아 DEPLOY_STATE_DIR/runtime.env 로 만들어진다.

# --- AWS ---
AWS_REGION=ap-southeast-2
# ECR 주소(<계정>.dkr.ecr.<리전>.amazonaws.com 꼴). 이 서버의 사용자 역할로 로그인한다.
ECR_REGISTRY=registry.example.invalid

# --- 배포 ---
# 서버는 이 값들을 읽기만 한다. 쓰는 것은 GitHub Actions 다.
DEPLOY_STANDBY_PARAM=/stock-reading/prod/deploy/standby-version
DEPLOY_URGENT_PARAM=/stock-reading/prod/deploy/urgent-version
# 비밀 설정을 담은 Parameter Store 경로. 이름 하나가 환경변수 하나다(예: <경로>/MARKET_DB_PASSWORD). 비우면 받지 않는다.
DEPLOY_CONFIG_PARAM_PATH=/stock-reading/prod/env/

# --- 데이터 서버 ---
# 데이터 서버의 사설 주소. Kafka(9092)와 Postgres(5432)에 이 주소로 닿는다.
DATA_PRIVATE_IP=10.0.0.10
POSTGRES_DB=stock

# --- 서비스 동작 ---
# 수집 타이머와 시세 제공자. 켜기 전에는 외부를 부르지 않는다(기본은 꺼짐·시뮬레이터).
COLLECTOR_SCHEDULE_ENABLED=true
COLLECTOR_PRE_OPEN_ENABLED=true
COLLECTOR_INTRADAY_ENABLED=true
COLLECTOR_INSIGHT_SCHEDULE_ENABLED=true
COLLECTOR_DAILY_BRIEFING_ENABLED=true
COLLECTOR_MEMBERS_ENABLED=true
COLLECTOR_MARKET_DATA_SOURCE=broker
# 메일 발송은 사람이 직접 true 로 바꾼다. false 이면 발송기는 로그만 남긴다.
NOTIFIER_SEND_ENABLED=false
