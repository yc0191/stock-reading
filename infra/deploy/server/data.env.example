# 데이터 서버의 설정 예시. 서버에서 /etc/stock-reading/data.env 로 복사해 채운다(권한 0600).
# Compose 의 --env-file 로 쓰므로 KEY=값 한 줄씩 쓴다. 아래 비밀번호는 모두 바꾼다.
# 비밀번호에 $, #, 공백이 들어가면 Compose 가 변수·주석으로 읽어 값이 잘리므로 작은따옴표로 감싼다(예: POSTGRES_ADMIN_PASSWORD='a$b#c'). 값에 작은따옴표는 쓰지 않는다.
# 자리표시 값은 change-me 이며, 같은 이름의 값을 서비스 서버의 Parameter Store(DEPLOY_CONFIG_PARAM_PATH 아래)에도 둔다.

# 데이터 서버의 사설 주소. Kafka·Postgres 포트를 이 주소에만 연다.
DATA_PRIVATE_IP=10.0.0.10
POSTGRES_DB=stock
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
MARKET_DB_USER=market_svc
MARKET_DB_PASSWORD=change-me
NEWS_DB_USER=news_svc
NEWS_DB_PASSWORD=change-me
BRIEFING_DB_USER=briefing_svc
BRIEFING_DB_PASSWORD=change-me

# --- 백업(backup-postgres.sh) ---
BACKUP_S3_BUCKET=stock-reading-backup-example
BACKUP_S3_PREFIX=postgres
AWS_REGION=ap-southeast-2
