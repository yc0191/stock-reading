# Copy to .env and fill in. .env is git-ignored; never commit real values.
POSTGRES_DB=stock
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
MARKET_DB_USER=market_svc
MARKET_DB_PASSWORD=change-me

# --- notifier (email) ---
# false = dry-run: emails are only logged. Set true only after the SMTP values below are filled in.
NOTIFIER_SEND_ENABLED=false
# Must be a verified identity in AWS SES (while the account is in the SES sandbox the recipient must be verified too).
NOTIFIER_SENDER=sender@example.com
NOTIFIER_RECIPIENT=you@example.com
# Use ASCII only in .env values. Spring reads this file as Latin-1, so non-ASCII text (e.g. Korean) gets garbled.
# The subject prefix defaults to "[시뮬레이션]" from application.yml; override it here only with ASCII, e.g.:
# NOTIFIER_SUBJECT_PREFIX=[SIMULATION]
NOTIFIER_MAX_PER_HOUR=6
# SES SMTP endpoint for your region (shown on the SES "SMTP settings" page) and the SMTP credentials created there.
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
