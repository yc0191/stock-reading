# Copy to .env and fill in. .env is git-ignored; never commit real values.
POSTGRES_DB=stock
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
MARKET_DB_USER=market_svc
MARKET_DB_PASSWORD=change-me
NEWS_DB_USER=news_svc
NEWS_DB_PASSWORD=change-me
BRIEFING_DB_USER=briefing_svc
BRIEFING_DB_PASSWORD=change-me

# --- notifier (email) ---
# false = dry-run: emails are only logged. Set true only after the SMTP values below are filled in.
NOTIFIER_SEND_ENABLED=false
# Must be a verified identity in AWS SES (while the account is in the SES sandbox the recipient must be verified too).
NOTIFIER_SENDER=sender@example.com
NOTIFIER_RECIPIENT=you@example.com
# Use ASCII only in .env values. Spring reads this file as Latin-1, so non-ASCII text (e.g. Korean) gets garbled.
# The subject prefix defaults to "[시뮬레이션]" from application.yml; override it here only with ASCII, e.g.:
# NOTIFIER_SUBJECT_PREFIX=[SIMULATION]
NOTIFIER_MAX_PER_HOUR=6
# SES SMTP endpoint for your region (shown on the SES "SMTP settings" page) and the SMTP credentials created there.
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me

# --- collector: external data sources ---
# Keys are loaded from Parameter Store by scripts/load_config.py. Everything else is set by hand.
# Disclosure API
DART_API_KEY=change-me
# Securities quote API
BROKER_BASE_URL=https://api.example.com
BROKER_APP_KEY=change-me
BROKER_APP_SECRET=change-me
# Market status lookup used to skip holidays. Take the values from the provider docs. Empty means every day counts as a business day.
BROKER_MARKET_STATUS_PATH=
BROKER_MARKET_STATUS_TODAY_FIELD=
BROKER_MARKET_STATUS_BUSINESS_DAY_FIELD=
# News search API. The two header names are defined by the provider.
NEWS_SEARCH_BASE_URL=https://api.example.com
NEWS_SEARCH_CLIENT_ID=change-me
NEWS_SEARCH_CLIENT_SECRET=change-me
NEWS_SEARCH_ID_HEADER=X-Example-Id
NEWS_SEARCH_SECRET_HEADER=X-Example-Secret
# Daily call cap for the news search API (Korea time, in-memory: resets on restart). Must be 1 or more.
NEWS_SEARCH_DAILY_CALL_LIMIT=19500
# Pause between consecutive news search calls in milliseconds. 0 disables it. Bursts may be rejected with HTTP 429.
NEWS_SEARCH_CALL_INTERVAL_MS=60
# Periodic schedule.tick publishing (market 30s, news 15min). Keep false locally and send ticks by hand with scripts/publish-tick.sh.
COLLECTOR_SCHEDULE_ENABLED=false

# --- briefing: LLM report ---
# Loaded from Parameter Store (/stock-reading/dev/briefing/anthropic-api-key) by scripts/load_config.py.
# Leave it empty (or change-me) to skip the LLM; the briefing then writes rule-based reports.
ANTHROPIC_API_KEY=change-me
BRIEFING_LLM_MODEL=claude-sonnet-5-5

# --- market: ETF constituent auto-fetch (leave empty to edit the instrument tables by hand) ---
# {fundId} and {date} (yyyy.MM.dd) are filled in per request. Placeholders only; put the real values in the shared .env.
MEMBERS_URL_TEMPLATE=
# Comma-separated ETF_CODE:SOURCE_ID pairs. ETFs not listed here are never fetched.
MEMBERS_FUND_IDS=
# Identifies the requests; ASCII only.
MEMBERS_USER_AGENT=stock-reading-members/1.0
# collector: publishes the collect-members tick (weekdays 07:30 KST by default). Off unless set to true by hand.
COLLECTOR_MEMBERS_ENABLED=false
# COLLECTOR_MEMBERS_CRON=0 30 7 * * MON-FRI
