{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-reading.local/contracts/news.filings.requested.v1",
  "title": "news.filings.requested v1",
  "description": "더 이상 쓰지 않음(2026-11-13). 브리핑은 이 자료를 뉴스처리기 내부 조회 API(POST /internal/news/filings)로 직접 부르고, 그 요청 본문이 이 이벤트의 payload 와 같은 모양이다. 토픽은 없앴고 옛 이벤트와 본문 모양을 확인할 수 있게 스키마와 샘플만 남긴다(ADR-010 호환 규칙). 브리핑이 news 서비스에 미국 종목들의 공시를 요청한다. 티커는 market.context.responded가 준 목록이며, 미국 종목이 없는 변동은 이 요청을 보내지 않는다. 읽기 전용 요청이라 같은 요청을 다시 보내도 부작용이 없다. 메시지 키는 변동 종목코드다.",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producedAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "news.filings.requested" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time", "description": "요청을 만든 시각." },
    "producedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "description": "작업을 시작시킨 market.move의 correlationId를 이어받는다." },
    "payload": {
      "type": "object",
      "required": ["jobId", "seq", "symbol", "tickers", "since", "until", "maxFilings"],
      "properties": {
        "jobId": { "type": "string", "format": "uuid", "description": "작업 키. 작업을 시작시킨 market.move의 eventId다." },
        "seq": { "type": "integer", "minimum": 1, "description": "요청 순번. 재전송은 새 순번을 쓰고, 응답이 같은 값을 되돌려준다." },
        "symbol": { "type": "string", "pattern": "^[0-9A-Z]{6}$", "description": "변동 종목코드. 메시지 키와 응답 짝짓기에만 쓰고 공시 조회에는 쓰지 않는다." },
        "tickers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9]{1,6}([.-][A-Z0-9]{1,2})?$" },
          "description": "공시를 찾을 미국 종목 티커."
        },
        "since": { "type": "string", "format": "date-time", "description": "접수 시각 하한. since <= acceptedAt." },
        "until": { "type": "string", "format": "date-time", "description": "접수 시각 상한. acceptedAt <= until." },
        "maxFilings": { "type": "integer", "minimum": 1, "description": "응답에 담을 최대 건수. 접수 시각 최신순으로 자른다." }
      }
    }
  }
}
