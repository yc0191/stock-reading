{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-reading.local/contracts/news.search-queries.v1",
  "title": "news.search-queries v1",
  "description": "뉴스 서비스가 검색어 테이블의 그때 전체 목록을 알린다. 테이블이 바뀐 것을 알아챈 때만 발행하고 변경분이 아니라 전체 목록이다. 압축 토픽이고 메시지 키가 고정이라 마지막 목록이 남는다. 수집기가 시작할 때 마지막 목록을 받아 뉴스 검색에 쓰고, 목록을 받기 전에는 검색하지 않는다. 같은 목록을 두 번 받아도 결과가 같아야 한다. 메시지 키는 고정값 \"search-queries\"다.",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producedAt", "correlationId", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "news.search-queries"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "뉴스 서비스가 테이블 변경을 알아챈 시각."
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "description": "변경 확인 회차마다 새로 만든 값."
    },
    "payload": {
      "type": "object",
      "required": ["contentHash", "queries"],
      "properties": {
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "정렬한 목록의 SHA-256. 바뀜 비교용."
        },
        "queries": {
          "type": "array",
          "description": "검색어 전체. 비어 있으면 검색하지 않는다.",
          "items": {
            "type": "object",
            "required": ["query", "symbols"],
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "검색 API에 보낼 검색어."
              },
              "symbols": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(\\*|[A-Z0-9]{1,6}([.-][A-Z0-9]{1,2})?)$"
                },
                "description": "이 검색어로 찾은 기사에 태그로 붙일 종목들. 국내 종목코드, 미국 티커(종류 구분은 \"-\"), 또는 \"*\"(시장 전체 이슈)다. 기존 설정 '검색어=종목코드,종목코드'와 같은 뜻이고 형식은 market.holdings의 symbol과 같다."
              }
            }
          }
        }
      }
    }
  }
}
