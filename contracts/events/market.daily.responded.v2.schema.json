{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-reading.local/contracts/market.daily.responded.v2",
  "title": "market.daily.responded v2",
  "description": "market 서비스가 데일리 판 자료 요청에 답한다. v1과 토픽이 같고 schemaVersion만 2다. ETF 목록은 종목 테이블의 국내 ETF 중 관계가 보유(HELD) 또는 관심(WATCH)인 종목(종목코드 순, maxEtfs까지)이며, 범위 안에 받은 일봉이 없거나 일봉 원문을 읽지 못해도 ETF는 목록에 남고 하루 등락 칸이 null이며 이유가 missingReason에 담긴다. 일봉이 있으면 하루 등락은 그 일봉 원문 레코드의 값을 공백만 걷어 옮긴다(계산하지 않음). 일봉이 없어도 미국 종목, 해외 등락률, ETF 정보는 그대로 담긴다. 미국 종목이 없는 ETF는 tickers가 빈 배열이다. 시장 배경 원문은 저장된 응답 원문 그대로이며 해석하지 않는다. ETF마다 선택 칸 relation(HELD/WATCH)으로 보유와 관심을 구분한다. 보유 수량 같은 개인 정보는 담지 않는다. 메시지 키는 jobId다. 요청이 includeOperations를 true로 보냈을 때만 선택 칸 operations(시세처리기 운영 상태)를 싣는다. 종목코드는 담지 않는다.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producedAt",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "market.daily.responded"
    },
    "schemaVersion": {
      "const": 2
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "응답을 만든 시각."
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "description": "요청의 correlationId를 이어받는다."
    },
    "payload": {
      "type": "object",
      "required": [
        "jobId",
        "seq",
        "etfs",
        "closeRates",
        "background",
        "truncated"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "format": "uuid",
          "description": "요청의 jobId."
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "요청의 seq."
        },
        "etfs": {
          "type": "array",
          "description": "관심 ETF(HELD 또는 WATCH인 국내 ETF, 종목코드 순, maxEtfs까지)의 하루 등락과 담긴 미국 종목. 일봉이 없거나 읽지 못한 ETF도 빠지지 않는다. 구성 종목으로만 아는 종목(NONE)은 담기지 않는다.",
          "items": {
            "type": "object",
            "required": [
              "symbol",
              "date",
              "close",
              "prevClose",
              "rate",
              "fetchedAt",
              "missingReason",
              "tickers",
              "tickersTruncated"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "pattern": "^[0-9A-Z]{6}$",
                "description": "ETF 종목코드."
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "description": "고른 일봉 레코드의 일자 원문. 받은 시각이 since~asOf 안인 일봉 원문 중 가장 늦게 받은 1건에서 일자가 가장 최근인 레코드다(일봉에는 시각이 없다). 일봉이 없으면 null."
              },
              "close": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "description": "그 레코드의 종가 원문(공백 제거). 일봉이 없으면 null."
              },
              "prevClose": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "description": "그 레코드의 전일 종가 원문(공백 제거). 일봉이 없으면 null."
              },
              "rate": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "description": "그 레코드의 등락률 원문(%, 공백 제거). 계산하지 않고 원문을 옮긴다. 일봉이 없으면 null."
              },
              "fetchedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "그 일봉 원문을 받은 시각(since <= fetchedAt <= asOf). 일봉이 없으면 null."
              },
              "tickers": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{1,6}([.-][A-Z0-9]{1,2})?$"
                },
                "description": "이 ETF에 담긴 미국 종목 티커(대응표 순서, maxTickers까지). 미국 종목이 없으면 빈 배열."
              },
              "tickersTruncated": {
                "type": "boolean",
                "description": "maxTickers 때문에 tickers가 잘렸으면 true."
              },
              "relation": {
                "type": "string",
                "enum": [
                  "HELD",
                  "WATCH"
                ],
                "description": "선택. 종목 테이블에서 이 ETF의 관계. HELD는 보유, WATCH는 관심이다. 보유 수량 같은 개인 정보는 담지 않는다. 없으면 구분을 모르는 응답이다."
              },
              "etf": {
                "type": "object",
                "description": "선택. 이 종목이 보유 종목 파일에 ETF로 있을 때만 담긴다. 이름·추종 대상·업종은 모르면 빠지고, 구성 종목은 비중 순위 순이며 maxTickers개까지다. 보유 수량 같은 개인 정보는 담지 않는다.",
                "required": [
                  "members",
                  "membersTruncated"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tracks": {
                    "type": "string",
                    "minLength": 1,
                    "description": "추종 대상."
                  },
                  "sector": {
                    "type": "string",
                    "minLength": 1
                  },
                  "members": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "market",
                        "symbol",
                        "rank"
                      ],
                      "properties": {
                        "market": {
                          "type": "string",
                          "pattern": "^[A-Z]{2,4}$",
                          "description": "시장 구분(KR, US, JP 등)."
                        },
                        "symbol": {
                          "type": "string",
                          "pattern": "^[0-9A-Z]{1,12}([.-][0-9A-Z]{1,2})?$"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "weight": {
                          "type": "string",
                          "pattern": "^[0-9]+(\\.[0-9]+)?$",
                          "description": "ETF 안의 비중(%). 모르면 빠진다."
                        },
                        "rank": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "비중 순위(1이 가장 큼)."
                        }
                      }
                    }
                  },
                  "membersTruncated": {
                    "type": "boolean",
                    "description": "maxTickers 때문에 members가 잘렸으면 true."
                  }
                }
              },
              "missingReason": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "no-daily-price-in-range",
                  "daily-price-unreadable",
                  null
                ],
                "description": "하루 등락 칸이 null인 이유. no-daily-price-in-range: 받은 시각이 since~asOf 안인 일봉이 없음. daily-price-unreadable: 일봉 원문은 있으나 일자·종가·전일 종가·등락률을 모두 읽은 레코드가 없음. 값이 있으면 null."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "missingReason": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "missingReason"
                  ]
                },
                "then": {
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "close": {
                      "type": "string"
                    },
                    "prevClose": {
                      "type": "string"
                    },
                    "rate": {
                      "type": "string"
                    },
                    "fetchedAt": {
                      "type": "string"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "date": {
                      "type": "null"
                    },
                    "close": {
                      "type": "null"
                    },
                    "prevClose": {
                      "type": "null"
                    },
                    "rate": {
                      "type": "null"
                    },
                    "fetchedAt": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "closeRates": {
          "type": "array",
          "description": "etfs에 담긴 미국 종목 티커(중복 제거) 중 등락률을 찾은 종목의 직전 정규장 등락률. 규칙은 market.context.responded의 closeRates와 같다. 후보가 없는 티커는 빠진다.",
          "items": {
            "type": "object",
            "required": [
              "ticker",
              "date",
              "closeAt",
              "rate",
              "fetchedAt"
            ],
            "properties": {
              "ticker": {
                "type": "string",
                "pattern": "^[A-Z0-9]{1,6}([.-][A-Z0-9]{1,2})?$"
              },
              "date": {
                "type": "string",
                "minLength": 1,
                "description": "고른 해외 일봉의 일자 원문."
              },
              "closeAt": {
                "type": "string",
                "format": "date-time",
                "description": "그 일자의 정규장 마감 시각. asOf 이하다."
              },
              "rate": {
                "type": "string",
                "minLength": 1,
                "description": "등락률 원문. 공백 제거 외에는 가공하지 않는다."
              },
              "fetchedAt": {
                "type": "string",
                "format": "date-time",
                "description": "이 값을 담은 응답을 받은 시각."
              }
            }
          }
        },
        "background": {
          "type": "array",
          "description": "시장 배경 종류(와 대상)마다 1건. 원인 근거가 아니라 판 기준 시각의 시장 상태를 보여 주는 자료다. 규칙은 market.context.responded의 background와 같고, 종목별 자료인 국내 일봉은 etfs에 따로 담는다.",
          "items": {
            "type": "object",
            "required": [
              "apiType",
              "target",
              "status"
            ],
            "properties": {
              "apiType": {
                "type": "string",
                "enum": [
                  "exchange-rate-summary",
                  "market-summary",
                  "world-index"
                ],
                "description": "자료 종류. market.insight의 apiType과 같은 값이다(환율종합, 시장종합, 세계지수)."
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "world-index는 대륙구분, 나머지는 null."
              },
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "missing",
                  "too-large"
                ],
                "description": "ok: 원문을 담음. missing: 받은 시각이 since~asOf 안인 자료가 없음. too-large: 원문이 maxResponseBytes를 넘어 뺌."
              },
              "response": {
                "type": "string",
                "minLength": 1,
                "description": "status가 ok일 때만. 저장된 응답 원문 그대로."
              },
              "fetchedAt": {
                "type": "string",
                "format": "date-time",
                "description": "status가 ok 또는 too-large일 때. 고른 자료를 받은 시각(since <= fetchedAt <= asOf)."
              },
              "responseBytes": {
                "type": "integer",
                "minimum": 1,
                "description": "status가 too-large일 때만. 뺀 원문의 크기(UTF-8 바이트)."
              },
              "indexRates": {
                "type": "array",
                "description": "선택. world-index이고 status가 ok 또는 too-large일 때만. 고른 원문의 지수마다 market이 계산한 등락률이다. 원문의 전일대비·등락률은 장이 끝난 지수에서 0으로 오므로 쓰지 않고, 같은 대륙의 저장 원문 중 받은 시각이 since~asOf 안이고 영업일이 더 이른 가장 최근 행의 종가를 직전 종가로 삼아 (종가 - 직전 종가) / 직전 종가 * 100으로 구한다.",
                "items": {
                  "type": "object",
                  "required": [
                    "code",
                    "name",
                    "businessDay",
                    "close",
                    "prevBusinessDay",
                    "prevClose",
                    "rate"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "description": "지수 코드 원문(공백 제거)."
                    },
                    "name": {
                      "type": "string",
                      "description": "지수 이름 원문(공백 제거)."
                    },
                    "businessDay": {
                      "type": "string",
                      "minLength": 1,
                      "description": "고른 원문의 영업일 원문(공백 제거)."
                    },
                    "close": {
                      "type": "string",
                      "minLength": 1,
                      "description": "고른 원문의 종가 원문(공백 제거)."
                    },
                    "prevBusinessDay": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "직전 행의 영업일. 직전 행이 없으면 null."
                    },
                    "prevClose": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "직전 행의 종가 원문(공백 제거). 직전 행이 없으면 null."
                    },
                    "rate": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "계산한 등락률(%, 소수 둘째 자리 반올림). 직전 행이 없거나 직전 종가가 0이면 null(없음)."
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "response",
                    "fetchedAt"
                  ],
                  "not": {
                    "required": [
                      "responseBytes"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "too-large"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "fetchedAt",
                    "responseBytes"
                  ],
                  "not": {
                    "required": [
                      "response"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "missing"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "allOf": [
                    {
                      "not": {
                        "required": [
                          "response"
                        ]
                      }
                    },
                    {
                      "not": {
                        "required": [
                          "fetchedAt"
                        ]
                      }
                    },
                    {
                      "not": {
                        "required": [
                          "responseBytes"
                        ]
                      }
                    },
                    {
                      "not": {
                        "required": [
                          "indexRates"
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "apiType": {
                      "not": {
                        "const": "world-index"
                      }
                    }
                  },
                  "required": [
                    "apiType"
                  ]
                },
                "then": {
                  "not": {
                    "required": [
                      "indexRates"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "apiType": {
                      "const": "world-index"
                    }
                  },
                  "required": [
                    "apiType"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "apiType": {
                      "enum": [
                        "exchange-rate-summary",
                        "market-summary"
                      ]
                    }
                  },
                  "required": [
                    "apiType"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "truncated": {
          "type": "boolean",
          "description": "maxEtfs 때문에 etfs가 잘렸으면 true."
        },
        "operations": {
          "type": "object",
          "description": "선택. 요청의 includeOperations가 true일 때만. 범위는 요청의 since~asOf(양끝 포함, since가 market의 최대 기간보다 오래되면 최대 기간까지만)이고, 시각은 시세처리기가 자료를 받은 시각이다(1초 현재가와 시세 실패는 시세처리기 저장 시각, 나머지 조회 자료는 수집기가 받은 시각). 종목코드는 담지 않는다.",
          "required": [
            "collections",
            "quoteFailures",
            "droppedMessages"
          ],
          "properties": {
            "collections": {
              "type": "array",
              "description": "수집 종류마다 1건씩 항상 4건(pre-open, quote-1s, intraday, post-close). 범위 안에 받은 자료가 없으면 receivedCount 0이고 두 시각은 null이다. pre-open은 보유 미국 종목 해외 일봉과 한국 시간 09:00 전에 받은 세계지수, quote-1s는 1초 현재가, intraday는 한국 시간 09:00 이후 16:00 전에 받은 환율종합·시장종합·세계지수, post-close는 국내 일봉과 한국 시간 16:00 이후에 받은 환율종합·시장종합·세계지수다.",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "firstReceivedAt",
                  "lastReceivedAt",
                  "receivedCount"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "pre-open",
                      "quote-1s",
                      "intraday",
                      "post-close"
                    ],
                    "description": "수집 종류. 장 시작 전, 1초 현재가, 장중, 장 마감 후."
                  },
                  "firstReceivedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "description": "범위 안에서 가장 일찍 받은 시각. 받은 자료가 없으면 null."
                  },
                  "lastReceivedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "description": "범위 안에서 가장 늦게 받은 시각. 받은 자료가 없으면 null."
                  },
                  "receivedCount": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "범위 안에 받아 저장한 자료 수(1초 현재가는 시세 건수, 나머지는 응답 건수). 1초 현재가는 시세 시각(as_of)이 받은 시각 앞뒤 1시간 안인 것만 센다."
