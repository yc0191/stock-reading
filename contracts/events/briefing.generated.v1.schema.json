{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-reading.local/contracts/briefing.generated.v1",
  "title": "briefing.generated v1",
  "description": "가격 변동을 설명하는 브리핑과 그 근거 목록. 공개 정보만 담는다(보유 종목·수량 없음).",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producedAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "briefing.generated" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time", "description": "변동의 asOf, 즉 설명하려는 시점." },
    "producedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "required": ["symbol", "changePercent", "asOf", "text", "evidence", "generatedBy"],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[0-9A-Z]{6}$" },
        "name": { "type": "string", "minLength": 1, "description": "선택. 종목(ETF) 이름. 메일 제목과 본문 첫 줄이 '이름(코드)'로 쓴다. 이름을 모르면 칸을 뺀다(빈 문자열을 넣지 않는다). 소비자는 칸이 없거나 비어 있으면 코드만 쓴다." },
        "changePercent": { "type": "number" },
        "asOf": { "type": "string", "format": "date-time" },
        "text": { "type": "string", "minLength": 1 },
        "generatedBy": { "type": "string", "minLength": 1, "description": "알려진 값: rule-based" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "source", "publishedAt"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "publishedAt": { "type": "string", "format": "date-time" },
              "articleId": { "type": "string", "minLength": 1, "description": "선택. news.articles.responded의 articleId. 리포트가 근거를 인용할 때 쓰는 식별자다. 없으면 이전 형식이다." },
              "url": { "type": "string", "format": "uri", "description": "선택. 기사 주소." },
              "kind": {
                "type": "string",
                "enum": ["article", "filing", "overseas-close-rate", "exchange-rate-summary", "market-summary", "world-index", "daily-price"],
                "description": "선택. 자료 종류. 기사, 공시, 미국 종목 직전 정규장 등락률, 배경 자료(환율종합, 시장종합, 세계지수, 국내 일봉) 순이다. 없으면 이전 형식(기사)이다."
              },
              "ref": { "type": "string", "minLength": 1, "description": "선택. 근거 번호. 브리핑이 LLM 입력에 붙여 준 번호 그대로이며 리포트 문장이 이 번호로 근거를 인용한다." }
            }
          }
        }
      }
    }
  }
}
