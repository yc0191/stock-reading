{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-reading.local/contracts/market.move.v1",
  "title": "market.move v1",
  "description": "종목의 직전 스냅샷 대비 변동이 설정한 임계값에 도달하면 발행한다. 보유 종목·수량 같은 개인정보를 절대 담지 않는다.",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producedAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "market.move" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time", "description": "가격이 관측된 시각 (스냅샷의 asOf)." },
    "producedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "required": ["symbol", "previousPrice", "price", "changePercent", "thresholdPercent", "asOf"],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[0-9A-Z]{6}$" },
        "previousPrice": { "type": "integer", "minimum": 0 },
        "price": { "type": "integer", "minimum": 0 },
        "changePercent": { "type": "number", "description": "(price - previousPrice) / previousPrice * 100, 소수점 2자리." },
        "thresholdPercent": { "type": "number", "minimum": 0 },
        "asOf": { "type": "string", "format": "date-time", "description": "변동 시각. detectionType이 window(유형 1)면 움직임 시작 시각, prevClose(유형 2)면 임계값을 처음 넘은 시각. detectionType이 없는 이전 형식에서는 감지한 스냅샷의 asOf." },
        "detectionType": { "type": "string", "enum": ["window", "prevClose"], "description": "선택. 감지 유형. window = 유형 1(최근 구간 대비 변동), prevClose = 유형 2(전일 종가 필드 대비 변동). 없으면 이전 형식." },
        "moveStartedAt": { "type": "string", "format": "date-time", "description": "선택. 움직임이 시작된 시각. window는 비교 구간에서 움직임이 시작된 시각, prevClose는 임계값을 처음 넘은 시각." }
      }
    }
  }
}
