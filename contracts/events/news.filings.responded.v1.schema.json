{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-reading.local/contracts/news.filings.responded.v1",
  "title": "news.filings.responded v1",
  "description": "더 이상 쓰지 않음(2026-11-13). 브리핑은 이 자료를 뉴스처리기 내부 조회 API(POST /internal/news/filings)로 직접 부르고, 그 응답 본문이 이 이벤트의 payload 와 같은 모양이다. 토픽은 없앴고 옛 이벤트와 본문 모양을 확인할 수 있게 스키마와 샘플만 남긴다(ADR-010 호환 규칙). news 서비스가 공시 요청에 답한다. 0건 응답도 정상 응답이다. 공시 본문은 담지 않고 메타데이터만 담는다. 메시지 키는 변동 종목코드다.",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producedAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "news.filings.responded" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time", "description": "응답을 만든 시각." },
    "producedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "description": "요청의 correlationId를 이어받는다." },
    "payload": {
      "type": "object",
      "required": ["jobId", "seq", "symbol", "filings", "truncated"],
      "properties": {
        "jobId": { "type": "string", "format": "uuid", "description": "요청의 jobId." },
        "seq": { "type": "integer", "minimum": 1, "description": "요청의 seq." },
        "symbol": { "type": "string", "pattern": "^[0-9A-Z]{6}$" },
        "filings": {
          "type": "array",
          "description": "접수 시각 최신순 공시. 같은 공시는 한 번만 담는다.",
          "items": {
            "type": "object",
            "required": ["accessionNumber", "tickers", "form", "items", "acceptedAt", "url"],
            "properties": {
              "accessionNumber": { "type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$", "description": "접수번호. 리포트의 근거 인용에 쓰는 식별자다." },
              "tickers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Z0-9]{1,6}([.-][A-Z0-9]{1,2})?$" },
                "description": "이 공시에 연결된 티커."
              },
              "form": { "type": "string", "minLength": 1, "maxLength": 20, "description": "공시 형식(예: 8-K, 6-K)." },
              "items": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 },
                "description": "8-K 항목 번호. 항목 구분이 없는 형식은 빈 배열이다."
              },
              "acceptedAt": { "type": "string", "format": "date-time", "description": "접수 시각. since <= acceptedAt <= until." },
              "url": { "type": "string", "format": "uri", "description": "공시 원문 주소." }
            }
          }
        },
        "truncated": { "type": "boolean", "description": "maxFilings 때문에 잘렸으면 true." }
      }
    }
  }
}
