{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-reading.local/contracts/filing.collected.v1",
  "title": "filing.collected v1",
  "description": "수집기가 SEC EDGAR 공시 이력에서 걸러 낸 공시 한 건을 발행한다. 본문은 담지 않고 메타데이터만 담는다. 메시지 키는 접수번호(accessionNumber)다. 임시 봉투 형식(ADR-010 초안).",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producedAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "filing.collected" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time", "description": "SEC 접수 시각(payload.acceptedAt과 같다)." },
    "producedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "description": "수집을 시작시킨 schedule.tick의 correlationId를 이어받는다." },
    "payload": {
      "type": "object",
      "required": ["tickers", "cik", "accessionNumber", "form", "items", "acceptedAt", "filingDate", "url"],
      "properties": {
        "tickers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9]{1,6}([.-][A-Z0-9]{1,2})?$" },
          "description": "이 회사에 해당하는 보유 미국 종목 티커(설정에 적은 표기 그대로). 한 회사가 여러 종류 주식을 상장하면 여럿이다."
        },
        "cik": { "type": "string", "pattern": "^[0-9]{10}$", "description": "SEC 회사 식별번호(앞을 0으로 채운 10자리)." },
        "accessionNumber": { "type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$", "description": "SEC 접수번호. 공시 한 건을 가리키는 고유 값." },
        "form": { "type": "string", "minLength": 1, "maxLength": 20, "description": "공시 형식(예: 8-K, 8-K/A, 6-K)." },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "8-K 항목 번호(예: 2.02). 항목 구분이 없는 형식(6-K 등)은 빈 배열이다."
        },
        "acceptedAt": { "type": "string", "format": "date-time", "description": "SEC 접수 시각. UTC, 초 단위." },
        "filingDate": { "type": "string", "format": "date", "description": "SEC 공시일(미국 동부 기준 날짜)." },
        "url": { "type": "string", "format": "uri", "description": "공시 원문(주 문서) 주소. 주 문서가 없으면 접수 색인 페이지 주소." }
      }
    }
  }
}
