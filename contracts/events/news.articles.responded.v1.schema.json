{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-reading.local/contracts/news.articles.responded.v1",
  "title": "news.articles.responded v1",
  "description": "더 이상 쓰지 않음(2026-11-13). 브리핑은 이 자료를 뉴스처리기 내부 조회 API(POST /internal/news/articles)로 직접 부르고, 그 응답 본문이 이 이벤트의 payload 와 같은 모양이다. 토픽은 없앴고 옛 이벤트와 본문 모양을 확인할 수 있게 스키마와 샘플만 남긴다(ADR-010 호환 규칙). news 서비스가 기사 요청에 답한다. 0건 응답도 정상 응답이다. 본문과 개인 정보는 담지 않는다. 메시지 키는 종목코드다.",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producedAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "news.articles.responded" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time", "description": "응답을 만든 시각." },
    "producedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "description": "요청의 correlationId를 이어받는다." },
    "payload": {
      "type": "object",
      "required": ["jobId", "seq", "symbol", "articles", "truncated"],
      "properties": {
        "jobId": { "type": "string", "format": "uuid", "description": "요청의 jobId." },
        "seq": { "type": "integer", "minimum": 1, "description": "요청의 seq." },
        "symbol": { "type": "string", "pattern": "^[0-9A-Z]{6}$" },
        "articles": {
          "type": "array",
          "description": "요청 종목(ETF)에 태그된 기사를 발행 시각 최신순으로 먼저 놓고, 그다음 그 ETF가 담은 구성 종목에 태그된 기사(ETF 자체 기사와 겹치는 기사 제외)를 발행 시각 최신순으로 놓은 뒤 maxArticles까지 자른다. 시장 전체(\"*\") 기사는 ETF 자체 기사에 속한다. 구성 종목 기사가 많아도 ETF 자체 기사가 먼저 남는다.",
          "items": {
            "type": "object",
            "required": ["articleId", "title", "summary", "publishedAt", "publisher", "url"],
            "properties": {
              "articleId": { "type": "string", "minLength": 1, "description": "news가 계산하는 기사 식별자(article_key). 리포트의 근거 인용과 응답 집합 비교에 쓴다." },
              "title": { "type": "string", "minLength": 1, "maxLength": 500 },
              "summary": { "type": "string", "maxLength": 2000, "description": "빈 문자열을 허용한다." },
              "publishedAt": { "type": "string", "format": "date-time" },
              "publisher": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "truncated": { "type": "boolean", "description": "maxArticles 때문에 잘렸으면 true." }
      }
    }
  }
}
