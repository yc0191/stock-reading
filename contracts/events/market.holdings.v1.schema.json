{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-reading.local/contracts/market.holdings.v1",
  "title": "market.holdings v1",
  "description": "시세처리기가 보유 종목 테이블(instrument, etf_member)의 그때 전체 목록을 알린다. 테이블 내용이 바뀐 것을 알아챈 때만 발행하고, 매번 변경분이 아니라 전체 목록이다. 토픽은 압축 토픽이고 메시지 키가 고정이라 마지막 목록이 남는다. 소비자(수집기, 뉴스)는 시작할 때 마지막 목록을 받고, 같은 목록을 두 번 받아도 결과가 같아야 한다. 비중·추종 대상·업종 같은 소비자가 쓰지 않는 칸은 싣지 않는다. 메시지 키는 고정값 \"holdings\"다.",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producedAt", "correlationId", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "market.holdings"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "시세처리기가 테이블 변경을 알아챈 시각."
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "description": "변경을 알아챈 확인 회차마다 새로 만든 값(요청이 없는 이벤트라 이어받을 값이 없다)."
    },
    "payload": {
      "type": "object",
      "required": ["contentHash", "instruments", "memberships"],
      "properties": {
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "목록 내용(instruments, memberships를 정렬한 것)의 SHA-256. 같은 목록이면 같은 값이라 소비자가 바뀌었는지 비교하는 데 쓴다."
        },
        "instruments": {
          "type": "array",
          "description": "종목 전체(ETF와 구성 종목). 비어 있으면 보유 종목이 없는 것이다.",
          "items": {
            "type": "object",
            "required": ["kind", "market", "symbol", "relation"],
            "properties": {
              "kind": {
                "enum": ["ETF", "STOCK"]
              },
              "market": {
                "type": "string",
                "pattern": "^[A-Z]{2,8}$",
                "description": "시장 구분(KR, US 등). 테이블이 시장 값을 제한하지 않아 enum으로 막지 않는다."
              },
              "symbol": {
                "type": "string",
                "pattern": "^[A-Z0-9]{1,6}([.-][A-Z0-9]{1,2})?$",
                "description": "종목코드 또는 티커. 종류 구분은 \"-\"로 맞춘 값이다."
              },
              "relation": {
                "enum": ["HELD", "WATCH", "NONE"],
                "description": "보유 중, 지켜보는 중, 구성 종목으로만 아는 종목."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "description": "선택. 종목 이름. 모르면 칸을 뺀다(null 아님). 다음 단계에서 뉴스 검색어를 이름으로 만들 때 쓴다."
              }
            }
          }
        },
        "memberships": {
          "type": "array",
          "description": "ETF가 담은 구성 종목 관계 전체. rank 오름차순이 비중 순위 순이다.",
          "items": {
            "type": "object",
            "required": ["etfMarket", "etfSymbol", "memberMarket", "memberSymbol", "rank"],
            "properties": {
              "etfMarket": {
                "type": "string",
                "pattern": "^[A-Z]{2,8}$"
              },
              "etfSymbol": {
                "type": "string",
                "pattern": "^[A-Z0-9]{1,6}([.-][A-Z0-9]{1,2})?$"
              },
              "memberMarket": {
                "type": "string",
                "pattern": "^[A-Z]{2,8}$"
              },
              "memberSymbol": {
                "type": "string",
                "pattern": "^[A-Z0-9]{1,6}([.-][A-Z0-9]{1,2})?$"
              },
              "rank": {
                "type": ["integer", "null"],
                "minimum": 1,
                "description": "비중 순위. 모르면 null."
              }
            }
          }
        }
      }
    }
  }
}
