{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-reading.local/contracts/market.insight.v1",
  "title": "market.insight v1",
  "description": "장 마감 후·장 시작 전에 조회한 API 응답 한 건의 원문. 일봉·세계지수·환율종합·시장종합·해외 일봉을 같은 이벤트로 싣고 payload.apiType으로 구분한다. 응답 내부는 해석하지 않는 불투명 JSON이다. 메시지 키는 \"<apiType>:<target>\"이고 target이 없으면 apiType만 쓴다. 보유 종목·수량 같은 개인정보를 절대 담지 않는다. 임시 봉투 형식(ADR-010 초안).",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producedAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "market.insight" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time", "description": "조회 시각(payload.fetchedAt과 같다)." },
    "producedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "description": "조회 회차(수집기 타이머 또는 수동 실행 명령)의 correlationId를 이어받는다." },
    "payload": {
      "type": "object",
      "required": ["apiType", "target", "response", "scheduledFor", "fetchedAt"],
      "properties": {
        "apiType": {
          "type": "string",
          "enum": ["daily-price", "world-index", "exchange-rate-summary", "market-summary", "overseas-daily-price"],
          "description": "어느 API의 응답인지. 일봉, 세계지수, 환율종합, 시장종합, 해외 일봉(미국 종목) 순이다."
        },
        "target": {
          "type": ["string", "null"],
          "description": "조회 대상 구분값. daily-price는 종목코드(6자리), world-index는 대륙구분, overseas-daily-price는 미국 티커(영문 대문자·숫자 1~6자, 종류 구분은 . 또는 - 뒤 1~2자), 나머지는 구분값이 없어 null이다. 해외 일봉의 거래소 코드는 응답 원문에 있다."
        },
        "response": {
          "type": "string",
          "minLength": 1,
          "description": "응답 본문 원문. 앞뒤 공백 제거 외에는 가공하지 않은 JSON 텍스트이며 소비자는 해석하지 않고 그대로 저장한다. 객체로 싣지 않는 것은 직렬화 과정에서 숫자 표기나 공백이 바뀌는 것을 막기 위해서다."
        },
        "scheduledFor": { "type": "string", "format": "date-time", "description": "조회 회차의 기준 시각(scheduledFor)." },
        "fetchedAt": { "type": "string", "format": "date-time", "description": "응답을 실제로 받은 시각." }
      },
      "allOf": [
        {
          "if": { "properties": { "apiType": { "const": "daily-price" } }, "required": ["apiType"] },
          "then": { "properties": { "target": { "type": "string", "pattern": "^[0-9A-Z]{6}$" } } }
        },
        {
          "if": { "properties": { "apiType": { "const": "world-index" } }, "required": ["apiType"] },
          "then": { "properties": { "target": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "apiType": { "const": "overseas-daily-price" } }, "required": ["apiType"] },
          "then": { "properties": { "target": { "type": "string", "pattern": "^[A-Z0-9]{1,6}([.-][A-Z0-9]{1,2})?$" } } }
        },
        {
          "if": { "properties": { "apiType": { "enum": ["exchange-rate-summary", "market-summary"] } }, "required": ["apiType"] },
          "then": { "properties": { "target": { "type": "null" } } }
        }
      ]
    }
  }
}
